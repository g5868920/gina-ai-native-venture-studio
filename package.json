{
  "name": "gina-ai-native-venture-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Repository-owned operating system for Gina AI-Native Venture Studio: governance, AI executive skills, portfolio coordination, decision preparation, and provenance.",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm test",
    "build": "tsc -p tsconfig.build.json",
    "portfolio-review": "pnpm build && node dist/cli.js",
    "demo": "pnpm build && node dist/cli.js inputs/venture-updates/2026-W28/pm-workflow.md inputs/venture-updates/2026-W28/twinko.md"
  },
  "dependencies": {
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
